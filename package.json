{
  "name": "akademik-takvim-platform",
  "version": "0.1.0",
  "private": true,
  "description": "University academic calendar notification platform MVP monorepo.",
  "type": "module",
  "scripts": {
    "start:api": "tsx apps/api/src/main.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:mobile": "vite --config apps/mobile/vite.config.ts",
    "dev:mobile:native": "npm --prefix apps/mobile-native run start",
    "android:mobile:native": "npm --prefix apps/mobile-native run android",
    "ios:mobile:native": "npm --prefix apps/mobile-native run ios",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:mobile": "vite build --config apps/mobile/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:mobile:native": "npm --prefix apps/mobile-native run typecheck",
    "validate": "npm run typecheck && npm run test && npm run build:admin && npm run build:mobile",
    "smoke:infra": "tsx scripts/smoke-infrastructure.ts",
    "compose:prod:config": "docker compose -f docker-compose.prod.yml config",
    "compose:prod:build": "docker compose -f docker-compose.prod.yml build",
    "compose:prod:build:classic": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:COMPOSE_BAKE='false'; docker compose -f docker-compose.prod.yml build\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@vitejs/plugin-react": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^13.9.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "mongoose": "^9.6.2",
    "nodemailer": "^8.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.0",
    "vite": "^7.3.3"
  }
}
