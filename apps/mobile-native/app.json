{
  "expo": {
    "name": "Akademik Takvim",
    "slug": "academic-pulse-native",
    "scheme": "academicpulse",
    "version": "0.1.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-reference.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anssoft.akademiktakvim",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "3",
      "appleTeamId": "VMGJVLFX95",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.anssoft.akademiktakvim",
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF5FF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-system-ui",
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-notifications",
        {
          "color": "#1463F3",
          "defaultChannel": "academic-updates",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/with-notification-manifest-overrides.cjs",
      "./plugins/with-android-production-security.cjs",
      "@react-native-community/datetimepicker"
    ]
  }
}
