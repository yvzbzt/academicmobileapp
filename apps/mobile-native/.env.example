# Optional: override API base URL explicitly.
# If omitted, the app uses the production VPS API.
EXPO_PUBLIC_API_URL=

# Optional: opt in to the old local dev API auto-detection in Expo dev mode
# (from Metro bundle host, falling back to emulator/simulator defaults).
EXPO_PUBLIC_USE_LOCAL_API=0

# Optional Google OAuth client IDs for native Google sign-in.
# Android native sign-in uses Google Play Services and requires an Android OAuth
# client to exist in Google Cloud/Firebase for the app package + SHA-1.
# Backend login needs an ID token; provide a Web OAuth client ID here when available.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
