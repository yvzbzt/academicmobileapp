# Optional: override API base URL explicitly.
# If omitted, the app auto-detects backend host in Expo dev mode
# (from Metro bundle host) and falls back to emulator/simulator defaults.
EXPO_PUBLIC_API_URL=

# Optional Google OAuth client IDs for Expo native Google sign-in.
# The Expo app can render Google login only when at least one of these is set.
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
